            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "OpenCV_DIR": "D:/user/OpenCv/opencv/build_for_VS"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "vs2022-debug",
            "configurePreset": "vs2022-debug"
        },
        {
            "name": "vs2022-release",
            "configurePreset": "vs2022-release"
        }
    ]
