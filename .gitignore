# ==========================================
# 1. AI 辅助工具及编辑器特定文件夹 (如 .claude)
# ==========================================
.claude/
.cursor/
.copilot/
.idea/
.vscode/

# ==========================================
# 2. Visual Studio 2022 缓存与本地设置
# ==========================================
.vs/
# 编译器生成的诊断数据库
*.opensdf
*.sdf
*.VC.db
*.VC.VC.opendb

# 用户特定的项目配置文件（如断点、窗口布局）
*.suo
*.user
*.userosscache
*.sln.docstates

# ==========================================
# 3. C++ 编译、链接及生成产物
# ==========================================
# 文件夹形式的输出
/[Dd]ebug/
/[Rr]elease/
/x64/
/x86/
/[Mm][Dd]/
/[Mm][Dd][Dd]/

# 如果使用 CMake 编译，VS 会默认生成到 out 目录
/out/
/build/

# 中间文件与目标文件
*.obj
*.o
*.pch
*.gch
*.pdb
*.ilk
*.idb
*.iobj
*.ipdb

# 最终生成的二进制文件（可选：如果需要提交编译好的 exe/dll，可以删掉这两行）
*.exe
*.dll
*.lib
*.a
*.so

# ==========================================
# 4. 其他日志及临时文件
# ==========================================
*.log
*.tlog
*.lastbuildstate